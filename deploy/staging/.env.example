# Copy to /opt/homecore/staging/.env (never commit real secrets)
HOMECORE_DOMAIN=staging.example.com
HOMECORE_IMAGE=ghcr.io/moraisnetocc/homecare-cloud:replace-with-sha
DJANGO_SECRET_KEY=replace-with-long-random-secret
DJANGO_ALLOWED_HOSTS=staging.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://staging.example.com
POSTGRES_DB=homecore
POSTGRES_USER=homecore
POSTGRES_PASSWORD=replace-with-long-random-password
